#!/bin/sh

set -eu

usage() {
    cat <<'EOF'
Usage: $(basename "$0") [duration]

Keep the system awake using `caffeinate` or `systemd-inhibit`.

Duration defaults to `1h`. Supported suffixes: `s`, `m`, `h`.
Examples: `30m`, `45s`, `2h`, `3600`
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -gt 1 ]; then
    usage >&2
    exit 1
fi

duration=${1:-1h}

case "$duration" in
*[!0-9])
    value=${duration%?}
    unit=${duration#$value}
    ;;
*)
    value=$duration
    unit=s
    ;;
esac

case "$value" in
'' | *[!0-9]*)
    printf 'Invalid duration: %s\n' "$duration" >&2
    exit 1
    ;;
esac

case "$unit" in
s) seconds=$((value)) ;;
m) seconds=$((value * 60)) ;;
h) seconds=$((value * 60 * 60)) ;;
*)
    printf 'Invalid duration unit: %s\n' "$duration" >&2
    exit 1
    ;;
esac

if command -v caffeinate >/dev/null 2>&1; then
    set -x
    killall caffeinate 2>/dev/null || true
    exec caffeinate -disu -t "$seconds"
elif command -v systemd-inhibit >/dev/null 2>&1; then
    set -x
    exec systemd-inhibit \
        --what=idle:sleep \
        --why="Keep the system awake for $duration" \
        sleep "$seconds"
else
    printf 'Neither caffeinate nor systemd-inhibit is available.\n' >&2
    exit 1
fi
